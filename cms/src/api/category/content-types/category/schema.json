{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": { "singularName": "category", "pluralName": "categories", "displayName": "Categoría", "description": "Tipo de producto (taxonomía curada, PLAN_STRAPI §3)" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "description": { "type": "text" },
    "order": { "type": "integer", "default": 0 },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "products": { "type": "relation", "relation": "oneToMany", "target": "api::product.product", "mappedBy": "category" }
  }
}
