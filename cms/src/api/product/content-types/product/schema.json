{
  "kind": "collectionType",
  "collectionName": "products",
  "info": { "singularName": "product", "pluralName": "products", "displayName": "Producto", "description": "Producto del catálogo" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "sku": { "type": "string", "unique": true },
    "shortDescription": { "type": "text", "maxLength": 300 },
    "description": { "type": "blocks" },
    "images": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "category": { "type": "relation", "relation": "manyToOne", "target": "api::category.category", "inversedBy": "products" },
    "channels": { "type": "relation", "relation": "manyToMany", "target": "api::channel.channel", "inversedBy": "products" },
    "brand": { "type": "relation", "relation": "manyToOne", "target": "api::brand.brand", "inversedBy": "products" },
    "presentation": { "type": "string" },
    "packaging": { "type": "string" },
    "dosage": { "type": "text" },
    "servingsPerPack": { "type": "string" },
    "unitsPerBox": { "type": "string" },
    "invimaRegistry": { "type": "string" },
    "flavors": { "type": "string" },
    "coffeeVariety": { "type": "string" },
    "price": { "type": "integer", "min": 0 },
    "compareAtPrice": { "type": "integer", "min": 0 },
    "priceVisible": { "type": "boolean", "default": true },
    "featured": { "type": "boolean", "default": false },
    "legacyId": { "type": "integer", "unique": true, "private": true },
    "legacyUrl": { "type": "string", "private": true },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
