# Plantilla de variables de entorno — copiar a .env.local (no se versiona).
# Todas son NEXT_PUBLIC_*: terminan en el HTML/JS público. NUNCA poner secretos aquí.
# Configurar las MISMAS variables en Vercel y Cloudflare Pages (Production y Preview).
# Documentación: docs/PLAN_DESARROLLO.md §8.4 y §11.

# Obligatoria. production | preview | development
# - production: exige SITE_URL, WHATSAPP_NUMBER y LEGACY_SITE_URL.
# - preview: los previews de ramas/PR; luego se marcan noindex (F3-09).
NEXT_PUBLIC_SITE_ENV=development

# URL canónica de la nueva web, sin barra final (obligatoria en production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp: solo dígitos con indicativo de país, p. ej. 57XXXXXXXXXX.
# Obligatoria en production. D-01 resuelto: +57 304 202 9533 (confirmado por el usuario el 2026-11-04).
NEXT_PUBLIC_WHATSAPP_NUMBER=573042029533

# Sitio actual (WordPress), base de los enlaces al catálogo/categorías (obligatoria en production).
NEXT_PUBLIC_LEGACY_SITE_URL=https://www.shaddaicolombia.com

# Opcional. URL que recibe el formulario de contacto. Si falta, se oculta «Enviar mensaje» (D-02).
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Política de tratamiento de datos personales (ruta interna /… o URL http(s)). PENDIENTE (D-03).
# Obligatoria en production SI hay NEXT_PUBLIC_CONTACT_ENDPOINT: sin ella el build falla a propósito.
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# Opcional. URL de iframe del mapa. Si falta, solo se muestra el enlace «Cómo llegar» (D-17).
NEXT_PUBLIC_MAPS_EMBED_URL=

# --- Catálogo (docs/PLAN_STRAPI.md §6) ---
# Solo variables de BUILD: NUNCA con prefijo NEXT_PUBLIC_ (el token no debe llegar al navegador).
# static (por defecto): sin catálogo propio; los CTA apuntan a la tienda actual.
# strapi: genera /productos/ en el build leyendo Strapi (exige STRAPI_URL y STRAPI_API_TOKEN).
CATALOG_SOURCE=static
# URL base de Strapi, sin barra final. Local: http://localhost:1337
STRAPI_URL=
# Token de Strapi de tipo «Read-only» (Settings → API Tokens).
STRAPI_API_TOKEN=
